# .env.example — VARIABLE NAMES ONLY. Never put a real value in this file.
#
# Copy to `.env` (which .gitignore already excludes) and fill it in, OR — the
# preferred path on macOS — put the secrets in the Keychain instead, so they
# cannot be committed even by accident:
#
#   security add-generic-password -a "$USER" -s yahoo_client_id -w
#   security add-generic-password -a "$USER" -s yahoo_client_secret -w
#   security add-generic-password -a "$USER" -s yahoo_fantasy_refresh_token:primary -w
#
# (omit the value from the command line; `security` prompts for it, so it never
# lands in your shell history or the process table)
#
# ⚠️ NEVER give any of these a hardcoded fallback in source. An unset credential
# must fail loudly, not silently "work" — that is RULE-SECRETS-001, and this
# repo already contains one counter-example (a live MFL API key committed as an
# os.environ.get default) that should not be copied.
#
# ⚠️ NOT STORED HERE OR ANYWHERE, EVER: your Yahoo password, verification/MFA
# codes, or browser cookies. The OAuth flow never needs them and this pipeline
# never asks for them.

# ── Yahoo Fantasy Sports (read-only) ────────────────────────────────────────
# From https://developer.yahoo.com/apps/create/ — register as an INSTALLED
# APPLICATION and tick Fantasy Sports → Read.
# ⚠️ As of 2026 Yahoo also gates API access behind an approval application at
# https://sports.yahoo.com/developer/access/ — see docs/yahoo_fantasy_ingestion.md.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Must byte-match the Redirect URI(s) value on the app's Yahoo registration
# page, and between the authorize call and the token exchange.
# ⚠️ Confirmed 2026-08-12: Yahoo's app-creation form rejects the bare string
# `oob` with "Invalid URI". Use a loopback URL instead, e.g.:
YAHOO_REDIRECT_URI=https://localhost:8080

# Only needed for the Worker-hosted OAuth flow: base64 of 32 random bytes,
# stored as a Worker secret, used to AES-256-GCM encrypt the refresh token at
# rest in D1. Generate with:  openssl rand -base64 32
YAHOO_TOKEN_ENCRYPTION_KEY=

# Optional: supply the refresh token directly instead of using the Keychain.
# Prefer the Keychain locally; use this only for CI, as a repo secret.
YAHOO_REFRESH_TOKEN=

# ── Cloudflare (already used by existing workflows) ─────────────────────────
# Needed only when writing to D1 with --target remote.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
