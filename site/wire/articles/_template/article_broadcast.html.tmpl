<!--wire-bcast-->
<style data-wire-bcast-style>
/* Broadcast mode controls (opt-in; see article_broadcast.js). Inserted by
   `wire.py broadcast`; the block is hidden until the script runs, so without
   JavaScript the issue shows nothing extra. No vh units (README rule 2). */
.wire-bcast{display:flex;flex-wrap:wrap;gap:.55rem .7rem;align-items:center;margin:1rem 0 .2rem}
.wire-bcast[hidden]{display:none}
.wire-bcast-start{display:inline-flex;align-items:center;gap:.5rem;min-height:44px;padding:.65rem 1.15rem;border:0;border-radius:999px;
  background:var(--gold);color:var(--on-gold);font:700 1rem/1.1 var(--display,system-ui);letter-spacing:.04em;text-transform:uppercase;cursor:pointer}
.wire-bcast-start:focus-visible,.wire-bcast-sound:focus-visible{outline:3px solid var(--gold-dim);outline-offset:2px}
.bcast-opened .wire-bcast-start{display:none}
.wire-bcast-sound{display:inline-flex;align-items:center;gap:.35rem;min-height:44px;padding:.5rem .85rem;border:1px solid var(--line-2);border-radius:999px;
  background:var(--surface);color:var(--ink);font:600 .85rem/1.1 system-ui,-apple-system,sans-serif;cursor:pointer}
.wire-bcast-sound [data-when]{white-space:nowrap}
.bcast-muted .wire-bcast-sound [data-when="on"],html:not(.bcast-muted) .wire-bcast-sound [data-when="off"]{display:none}
.wire-bcast-note{flex-basis:100%;margin:0;font-size:.78rem;line-height:1.4;color:var(--ink-mute)}
.wire-bcast-dock{position:fixed;right:12px;bottom:12px;z-index:30;display:flex;flex-wrap:wrap;justify-content:flex-end;align-items:center;gap:.45rem;max-width:calc(100% - 24px)}
.wire-bcast-dock[hidden]{display:none}
.bcast-inframe .wire-bcast-dock{position:static;justify-content:flex-start;max-width:none}
.wire-bcast-caption{max-width:15rem;padding:.4rem .65rem;border-radius:8px;background:#1F1A2E;color:#F4EEFC;font:600 .78rem/1.3 system-ui,-apple-system,sans-serif;
  opacity:0;transition:opacity .2s}
.wire-bcast-caption.on{opacity:1}
.wire-bcast-caption:empty{display:none}
.wire-bcast-mini{min-height:32px;padding:.25rem .6rem;margin-left:.5rem;font-size:.72rem;vertical-align:middle}
html:not(.bcast-on) .wire-bcast-mini{display:none}
@keyframes bcastTitle{0%{transform:scale(.86);letter-spacing:.2em;opacity:.15}55%{transform:scale(1.04);letter-spacing:.02em;opacity:1}100%{transform:none}}
@keyframes bcastSweep{from{transform:translateX(-120%)}to{transform:translateX(120%)}}
@keyframes bcastOnAir{0%{box-shadow:0 0 0 0 var(--gold);transform:translateY(4px)}35%{box-shadow:0 0 0 3px var(--gold)}100%{box-shadow:0 0 0 0 transparent;transform:none}}
.wire-hero.bcast-intro .brand{position:relative;overflow:hidden;animation:bcastTitle 1.15s cubic-bezier(.2,.8,.2,1) both}
.wire-hero.bcast-intro .brand::after{content:"";position:absolute;top:0;right:0;bottom:0;left:0;pointer-events:none;
  background:linear-gradient(100deg,transparent 30%,rgba(255,255,255,.55) 50%,transparent 70%);animation:bcastSweep .9s .35s ease-out both}
.lt.bcast-onair{animation:bcastOnAir 1.4s ease-out both}
@media (prefers-reduced-motion: reduce){.wire-hero.bcast-intro .brand,.wire-hero.bcast-intro .brand::after,.lt.bcast-onair{animation:none}}
</style>
<div class="wire-bcast" data-wire-bcast data-cue-transition="{{TRANSITION}}" data-cue-closing="{{CLOSING}}" hidden>
  <button type="button" class="wire-bcast-start" data-bcast-start><span aria-hidden="true">&#9654;</span> Start UPS Center</button>
  <button type="button" class="wire-bcast-sound" data-bcast-toggle aria-pressed="true" aria-label="Sound"><span aria-hidden="true">&#9834;</span> <span data-when="on">Sound on</span><span data-when="off">Sound off</span></button>
  <p class="wire-bcast-note">Preview sound: temporary original cues made for UPS Center, with no ESPN audio. Each cue shows a caption, and the issue reads the same with sound off.</p>
  <div class="wire-bcast-dock" data-bcast-dock hidden>
    <span class="wire-bcast-caption" data-bcast-caption aria-live="polite"></span>
    <button type="button" class="wire-bcast-sound" data-bcast-toggle aria-pressed="true" aria-label="Sound"><span aria-hidden="true">&#9834;</span> <span data-when="on">Sound on</span><span data-when="off">Sound off</span></button>
  </div>
  <template data-bcast-captions>
    <span data-cap="opening">&#9835; UPS Center opening theme</span>
    <span data-cap="boomer">&#9835; Highlight-package music</span>
    <span data-cap="transition">&#9835; Segment sting</span>
    <span data-cap="kenny">&#9835; Coffee-cup clink: a receipt from the league chat</span>
    <span data-cap="closing">&#9835; UPS Center closing theme</span>
  </template>
</div>
<!--/wire-bcast-->
