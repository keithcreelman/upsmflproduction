<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.keith.mfl.cron-liveness</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/keithcreelman/Code/MFL/upsmflproduction/scripts/cron_liveness_tick.sh</string>
  </array>

  <!-- Every 5 minutes. This is the watchdog OF the watchdog: the in-worker
       auction-poll alarm rides Cloudflare's own */2 cron, so it cannot report
       "Cloudflare stopped running crons" — which is exactly what happened on
       2026-07-15 and again (for the report cron) on 2026-07-27. This job runs
       off-platform and DMs Discord directly, so it survives a dead worker. -->
  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <true/>

  <!-- No secrets here. The tick script pulls both the commish API key and the
       Discord bot token from macOS Keychain at runtime (items:
       ups-commish-api-key, discord_bot_token). -->

  <key>StandardOutPath</key>
  <string>/tmp/ups_cron_liveness.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/ups_cron_liveness.err.log</string>
</dict>
</plist>
