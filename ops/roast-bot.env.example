# UPS Trade Roast Bot — environment variables
# Copy to /etc/roast-bot.env (systemd) or load via launchd/your shell rc.
# DO NOT commit the populated version to git — contains secrets.

# ── Required ──────────────────────────────────────────────────────────────

# Anthropic API key (Opus 4.6 + Sonnet 4.6)
ANTHROPIC_API_KEY=sk-ant-...

# Discord bot token — rotate before first run (prior token in commit 2e29441 is burned)
DISCORD_BOT_TOKEN=

# Production Discord channel ID for live roasts
DISCORD_PROD_CHANNEL_ID=

# Toggle to production channel (any other value or unset = test channel)
ROAST_BOT_ENV=prod

# ── Optional ──────────────────────────────────────────────────────────────

# Override test channel ID (default: 1089538054236160010)
# DISCORD_TEST_CHANNEL_ID=

# Path to Discord user mapping CSV (contains PII — do not commit)
# Default on macOS: ~/Library/Mobile Documents/com~apple~CloudDocs/Documents/mfl/mfl_python/dev/import_discord_info.csv
# On a deploy host, set explicitly:
DISCORD_USERS_CSV=/etc/roast-bot/import_discord_info.csv
