# UPS Roast Bot — local secrets file
# Copy to: ops/roast-bot.env.local (gitignored — DO NOT commit)
# Edit with your actual values, then `chmod 600` to lock down read access.

# Anthropic API key for Opus 4.6 (roast) + Sonnet 4.6 (classify)
ANTHROPIC_API_KEY=sk-ant-...

# Discord bot token (the new one you just rotated)
DISCORD_BOT_TOKEN=

# Production Discord channel ID for live roasts
DISCORD_PROD_CHANNEL_ID=

# Flip to "prod" once you've verified test posts look right.
# Anything else (or unset) routes to the test channel (1089538054236160010).
ROAST_BOT_ENV=test

# Path to the Discord user mapping CSV (contains owner names + Discord IDs).
# Defaults to the iCloud-synced copy if unset.
# IMPORTANT: paths with spaces MUST be wrapped in single quotes (this file is
# sourced by bash; unquoted spaces split the value).
DISCORD_USERS_CSV='/Users/keithcreelman/Library/Mobile Documents/com~apple~CloudDocs/Documents/mfl/mfl_python/dev/import_discord_info.csv'

# Optional — pin the trade-value model path if you have one outside the repo
# TRADE_VALUE_MODEL_PATH='/Users/keithcreelman/Library/Mobile Documents/com~apple~CloudDocs/Documents/New project/site/trade-value/trade_value_model_2026.json'
