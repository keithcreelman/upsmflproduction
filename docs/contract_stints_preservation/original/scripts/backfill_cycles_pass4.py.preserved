#!/usr/bin/env python3
"""Pass 4 deferred-cycle enrichment — addresses the 2,338 cycles that Pass 3
deferred (offseason drops, snapshot lookup failures, W=1 drops). Pulls
last-in-season state from prior-year W=16 snapshots (with any-franchise
fallback for trade-carried contracts), or falls back to canonical
acquisition-event salary, or final-defers.

Snapshot sources:
  - /tmp/mfl_rosters_pass3_*.json (80 staged + 2019 W=16 fetched 2026-05-09)
  - /tmp/mfl_canonical_events_*.json (2019-2024 canonical events for fallback)
  - site/ccc/restructure_submissions.json (informational restructure-overlap flag)

Lookup chains (per Pass 4 sample diagnosis):

  Bucket 1 (offseason drop) / Bucket 3 (W=1 drop):
    1. (last_in_season_year, W=16) at holding franchise
    2. (last_in_season_year, W=16) at any franchise (refinement A — contract carries via trades)
    3. Canonical AUCTION_WON / BBID_WAIVER add event salary at cycle start (refinement B)
    4. Final defer with notes='pass4_no_snapshot_or_event'

  Bucket 2 (snapshot lookup failed):
    1. W=drop_week at holding (47% rescue per diagnosis)
    2. W=drop_week+1 at holding (3%)
    3. W=drop_week-2 at holding (<2%)
    4. W=drop_week-1 at OTHER franchise (trade-chain pattern, 7%)
    5. Canonical event fallback
    6. Final defer with notes='pass4_no_rescue'

Tag-cut-pre-auction fix: cap_penalty.py:165 `is_cap_free` now returns
cap_free=True (tag_cut_pre_auction) when contract_type='tag' and drop_date
falls before that year's FA Auction window. Auto-applies in Pass 4 outputs.

D1 batch size 100. Idempotent: re-running re-applies same UPDATEs.

Usage:
  python3 backfill_cycles_pass4.py [--dry-run | --apply]
  Default: --dry-run.
"""

import argparse
import json
import re
import subprocess
import sys
import time
from collections import defaultdict
from datetime import date, datetime, timedelta
from glob import glob
from pathlib import Path
from typing import Optional

REPO_ROOT = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(REPO_ROOT / "pipelines" / "etl" / "lib"))

import cap_penalty as cp                    # noqa: E402

STAGE_DIR = Path("/tmp")
SNAPSHOT_GLOB = "/tmp/mfl_rosters_pass3_*.json"
CANONICAL_GLOB = "/tmp/mfl_canonical_events_*.json"
RESTRUCTURE_JSON = REPO_ROOT / "site" / "ccc" / "restructure_submissions.json"
SOURCE_TAG = "backfill_pass4_2026_05_09"

REG_SEASON_WEEKS = {2019: 16, 2020: 16, 2021: 16, 2022: 16, 2023: 16, 2024: 16}
WEEK1_THURSDAY = {
    2019: date(2019, 9, 5),  2020: date(2020, 9, 10), 2021: date(2021, 9, 9),
    2022: date(2022, 9, 8),  2023: date(2023, 9, 7),  2024: date(2024, 9, 5),
}

D1_BATCH_SIZE = 100


# ---------------------------------------------------------------------------
# contractInfo parser (lifted from /tmp/pass3_parse_ci.py, validated against
# Pass 4 sample). Includes apostrophe-year extension guard, Underpay support,
# AAV math-mean fallback.
# ---------------------------------------------------------------------------

_TCV_RE = re.compile(r"\bTCV\s*\(?\s*([\d.]+)\s*([KkMm])?\)?", re.IGNORECASE)
_AAV_RE = re.compile(r"\bAAV\s*\(?\s*([\d.]+)\s*([KkMm])?\)?", re.IGNORECASE)
_ARRAY_RE = re.compile(r"\[([^\]]+)\]")
_CL_RE = re.compile(r"\bCL\s*(\d+)", re.IGNORECASE)
_Yn_RE = re.compile(r"\bY(\d)-?\s*([\d.]+)\s*([KkMm])?", re.IGNORECASE)
_APOSTROPHE_YEAR_RE = re.compile(r"'(\d{2})\b")
_EXTENSION_KEYWORD_RE = re.compile(r"\bExt(?:\.|ended|1|2)?\s+\S", re.IGNORECASE)
_UNDERPAY_RE = re.compile(r"\bUnderpay\s+([\d.]+)\s*([KkMm])?", re.IGNORECASE)


def _money(num_str: str, suffix: Optional[str]) -> Optional[int]:
    if not num_str:
        return None
    try:
        val = float(num_str)
    except ValueError:
        return None
    mult = 1
    if suffix and suffix.upper() == "K":
        mult = 1000
    elif suffix and suffix.upper() == "M":
        mult = 1_000_000
    amt = int(val * mult)
    if mult == 1 and amt < 1000:
        amt *= 1000
    return amt


def _parse_year_array(arr_text: str) -> list[int]:
    out = []
    for piece in arr_text.split(","):
        m = re.match(r"\s*([\d.]+)\s*([KkMm])?\s*$", piece)
        if m:
            v = _money(m.group(1), m.group(2))
            if v is not None:
                out.append(v)
    return out


def parse_contract_info(ci: Optional[str]) -> dict:
    s = (ci or "").strip()
    out = {
        "contract_length": None, "tcv": None, "aav": None, "aav_source": None,
        "year_salaries": [], "gf_flag": False, "extension_flag": False,
        "is_tag": False, "apostrophe_years": [], "underpay_explicit": None,
        "raw": s, "parser_format": "empty",
    }
    if not s:
        return out

    out["gf_flag"] = "GF" in s.upper()
    out["extension_flag"] = ("EXT:" in s.upper()) or "EXT." in s.upper()
    out["is_tag"] = bool(re.match(r"^\s*Tag\b", s, re.IGNORECASE))

    if _EXTENSION_KEYWORD_RE.search(s):
        out["apostrophe_years"] = sorted({m.group(1) for m in _APOSTROPHE_YEAR_RE.finditer(s)})

    m_up = _UNDERPAY_RE.search(s)
    if m_up:
        out["underpay_explicit"] = _money(m_up.group(1), m_up.group(2))

    if "CL" in s.upper() or "|" in s:
        out["parser_format"] = "post2021"
    else:
        out["parser_format"] = "pre2021"

    m = _CL_RE.search(s)
    if m:
        try:
            out["contract_length"] = int(m.group(1))
        except ValueError:
            pass

    m = _TCV_RE.search(s)
    if m:
        out["tcv"] = _money(m.group(1), m.group(2))

    m = _AAV_RE.search(s)
    if m:
        out["aav"] = _money(m.group(1), m.group(2))

    yn_matches = _Yn_RE.findall(s)
    if yn_matches:
        ys = sorted([(int(y), _money(v, suf)) for (y, v, suf) in yn_matches], key=lambda x: x[0])
        out["year_salaries"] = [v for _, v in ys if v is not None]

    if not out["year_salaries"]:
        m = _ARRAY_RE.search(s)
        if m:
            out["year_salaries"] = _parse_year_array(m.group(1))

    if out["contract_length"] is None and out["year_salaries"]:
        out["contract_length"] = len(out["year_salaries"])

    if out["is_tag"] and out["contract_length"] is None:
        out["contract_length"] = 1

    if out["apostrophe_years"] and out["contract_length"] is None:
        out["contract_length"] = len(out["apostrophe_years"])

    if out["aav"] is not None:
        out["aav_source"] = "explicit"
    elif out["year_salaries"]:
        out["aav"] = sum(out["year_salaries"]) // len(out["year_salaries"])
        out["aav_source"] = "mean_of_years"

    return out


# ---------------------------------------------------------------------------
# contract_type mapping (per league_context_v1.md §1.C9, locked 2026-05-09)
# ---------------------------------------------------------------------------

CONTRACT_STATUS_MAP = {
    "Rookie": "rookie", "Veteran": "veteran", "WW": "waiver_wire",
    "FL": "front_loaded", "BL": "back_loaded",
    "Rookie/Veteran": "rookie_extended", "Rookie|Veteran": "rookie_extended",
    "Tag": "franchise_tag", "Franchise Tag": "franchise_tag",
    "Franchise": "franchise_tag", "Transition": "franchise_tag",
}
TAG_FAMILY = {"franchise_tag"}
CALC_CONTRACT_TYPE = {
    "rookie": "rookie", "veteran": "veteran", "waiver_wire": "ww",
    "front_loaded": "veteran", "back_loaded": "veteran",
    "rookie_extended": "rookie", "franchise_tag": "tag", "unknown": "veteran",
}


def normalize_status(cs: str) -> str:
    if not cs:
        return "unknown"
    return CONTRACT_STATUS_MAP.get(cs.replace(" GF", "").strip(), "unknown")


# ---------------------------------------------------------------------------
# Resource loading
# ---------------------------------------------------------------------------

def load_roster_index() -> dict:
    """{(year, week): {(fid, pid): player_row}}"""
    idx = {}
    for path in sorted(glob(SNAPSHOT_GLOB)):
        parts = Path(path).stem.split("_")
        year, week = int(parts[3]), int(parts[4][1:])
        payload = json.load(open(path))
        franchises = payload.get("rosters", {}).get("franchise", [])
        if isinstance(franchises, dict):
            franchises = [franchises]
        bucket = {}
        for f in franchises:
            fid = str(f.get("id"))
            players = f.get("player", [])
            if isinstance(players, dict):
                players = [players]
            for p in players:
                bucket[(fid, str(p.get("id")))] = p
        idx[(year, week)] = bucket
    return idx


def load_canonical_events_by_pid() -> dict:
    by_pid = defaultdict(list)
    for path in sorted(glob(CANONICAL_GLOB)):
        d = json.load(open(path))
        for e in d.get("events", []):
            by_pid[str(e.get("player_id"))].append(e)
    for pid in by_pid:
        by_pid[pid].sort(key=lambda x: x.get("ts_iso", ""))
    return by_pid


def load_restructures() -> dict:
    if not RESTRUCTURE_JSON.exists():
        return {}
    d = json.load(open(RESTRUCTURE_JSON))
    out = {}
    for s in d.get("submissions", []):
        key = (str(s.get("player_id")), str(s.get("franchise_id")))
        ts = s.get("submitted_at_utc")
        if ts:
            out.setdefault(key, []).append(ts)
    return out


def query_d1_deferred() -> list[dict]:
    """Pull all Pass 3-deferred cycles."""
    sql = (
        "SELECT cycle_id, player_id, franchise_id, season, acquisition_path, "
        "acquisition_date, acquisition_week, drop_date, drop_week, drop_reason, notes "
        "FROM player_acquisition_cycles "
        "WHERE source='backfill_pass3_2026_05_09' AND notes LIKE 'pass3_deferred%' "
        "ORDER BY cycle_id;"
    )
    out = subprocess.run(
        ["npx", "wrangler", "d1", "execute", "ups-mfl-db", "--remote", "--json", "--command", sql],
        capture_output=True, text=True, cwd=str(REPO_ROOT / "worker"),
    )
    return json.loads(out.stdout)[0]["results"]


# ---------------------------------------------------------------------------
# Per-cycle enrichment
# ---------------------------------------------------------------------------

def utc_str_to_et_date(ts: str) -> date:
    dt_utc = datetime.strptime(ts[:19], "%Y-%m-%d %H:%M:%S")
    offset = 4 if 3 <= dt_utc.month <= 10 else 5
    return (dt_utc - timedelta(hours=offset)).date()


def weeks_active_for_cycle(acq_dt_et: date, drop_dt_et: date) -> int:
    total = 0
    for season in sorted(REG_SEASON_WEEKS):
        wk1 = WEEK1_THURSDAY[season]
        for w in range(1, REG_SEASON_WEEKS[season] + 1):
            ws = wk1 + timedelta(days=7 * (w - 1))
            we = ws + timedelta(days=6)
            if ws <= drop_dt_et and we >= acq_dt_et:
                total += 1
    return total


def find_player_at_any_franchise(roster_idx: dict, year: int, week: int, pid: str) -> tuple:
    """Refinement A: search ALL franchises at (year, week)."""
    bucket = roster_idx.get((year, week), {})
    for (fid, p), row in bucket.items():
        if p == pid:
            return row, fid
    return None, None


def find_canonical_acquisition_event(events_by_pid: dict, cycle: dict) -> Optional[dict]:
    """Refinement B: cycle's acquisition event (with salary, if available)."""
    pid = str(cycle["player_id"])
    fid = str(cycle["franchise_id"])
    acq_dt = cycle["acquisition_date"]
    candidates = [
        e for e in events_by_pid.get(pid, [])
        if e.get("ts_iso", "")[:19] == acq_dt[:19]
        and str(e.get("franchise_id")) == fid
        and e.get("action") == "add"
    ]
    if not candidates:
        for e in events_by_pid.get(pid, []):
            if (e.get("ts_iso", "")[:10] == acq_dt[:10] and e.get("action") == "add"
                    and str(e.get("franchise_id")) == fid):
                candidates.append(e)
    if candidates:
        for e in candidates:
            if e.get("salary") is not None:
                return e
        return candidates[0]
    return None


def event_to_synthetic_snapshot(event: Optional[dict], cycle: dict) -> Optional[dict]:
    if event is None:
        return None
    sal = event.get("salary")
    if sal is None:
        return None
    path = cycle.get("acquisition_path", "")
    cs_guess = {"auction": "Veteran", "ww": "WW", "fcfs": "WW",
                "trade": "Veteran", "rookie_draft": "Rookie"}.get(path, "Veteran")
    return {
        "salary": str(sal), "contractYear": "1",
        "contractStatus": cs_guess, "contractInfo": "",
        "_synthetic_from_event": True,
    }


def determine_last_in_season_year(drop_dt_et: date, drop_week) -> int:
    """Per Pass 4 sample logic: drops in JanFeb or MarAug of year N use year (N-1)
    as the prior-season anchor; SepDec drops use year N. W=1 drops use (N-1)."""
    drop_year = drop_dt_et.year
    drop_month = drop_dt_et.month
    if drop_week == 1 or drop_month <= 8:
        return drop_year - 1
    return drop_year


def lookup_offseason_or_w1(cycle: dict, roster_idx: dict, events_by_pid: dict) -> tuple:
    drop_dt_et = utc_str_to_et_date(cycle["drop_date"])
    fid = str(cycle["franchise_id"])
    pid = str(cycle["player_id"])
    last_year = determine_last_in_season_year(drop_dt_et, cycle.get("drop_week"))

    # 1. Holding franchise at (last_year, W=16)
    if last_year in REG_SEASON_WEEKS:
        snap = roster_idx.get((last_year, 16), {}).get((fid, pid))
        if snap:
            return snap, f"api_W16_{last_year}_holding_fid"

        # 2. Refinement A: any franchise at (last_year, W=16)
        snap, other_fid = find_player_at_any_franchise(roster_idx, last_year, 16, pid)
        if snap:
            return snap, f"api_W16_{last_year}_other_fid={other_fid}"

    # 3. Refinement B: canonical event salary (rare — most events lack salary)
    event = find_canonical_acquisition_event(events_by_pid, cycle)
    synth = event_to_synthetic_snapshot(event, cycle)
    if synth:
        return synth, f"canonical_event_fallback_{event.get('transaction_type')}"

    return None, "pass4_no_snapshot_or_event"


def lookup_bucket2(cycle: dict, roster_idx: dict, events_by_pid: dict) -> tuple:
    drop_dt_et = utc_str_to_et_date(cycle["drop_date"])
    drop_year = drop_dt_et.year
    drop_week = int(cycle["drop_week"])
    fid = str(cycle["franchise_id"])
    pid = str(cycle["player_id"])

    for offset, label in [(0, "W=drop_week"), (+1, "W=drop_week+1"), (-2, "W=drop_week-2")]:
        target_week = drop_week + offset
        if target_week < 1 or target_week > 16:
            continue
        snap = roster_idx.get((drop_year, target_week), {}).get((fid, pid))
        if snap:
            return snap, f"bucket2_rescue_{label}"

    # Trade-chain refinement: any franchise at W=drop_week-1
    snap, other_fid = find_player_at_any_franchise(roster_idx, drop_year, drop_week - 1, pid)
    if snap and other_fid != fid:
        return snap, f"bucket2_other_fid={other_fid}_at_dw-1_trade_chain"

    event = find_canonical_acquisition_event(events_by_pid, cycle)
    synth = event_to_synthetic_snapshot(event, cycle)
    if synth:
        return synth, f"bucket2_canonical_event_{event.get('transaction_type')}"

    return None, "pass4_no_rescue"


def derive_actual_paid(tcv: Optional[int], year_salaries: list, raw_salary: Optional[int],
                       cl: int, cy_remaining: Optional[int]) -> tuple[int, str]:
    if year_salaries:
        if tcv is not None:
            return max(0, tcv - sum(year_salaries)), "tcv_minus_remaining"
        return 0, "zero"
    years_played = max(0, cl - (cy_remaining or cl))
    if raw_salary and years_played > 0:
        return years_played * raw_salary, "years_played_x_salary_flat"
    return 0, "zero"


def enrich_one(cycle: dict, roster_idx: dict, events_by_pid: dict, restructures: dict) -> dict:
    cid = cycle["cycle_id"]
    pid = str(cycle["player_id"])
    fid = str(cycle["franchise_id"])
    notes = cycle.get("notes", "") or ""

    drop_dt_et = utc_str_to_et_date(cycle["drop_date"])
    drop_year = drop_dt_et.year
    acq_dt_et = utc_str_to_et_date(cycle["acquisition_date"])

    weeks_active = weeks_active_for_cycle(acq_dt_et, drop_dt_et)

    rs_dates = restructures.get((pid, fid), [])
    rs_in_window = [ts for ts in rs_dates if cycle["acquisition_date"] <= ts <= cycle["drop_date"]]

    # Lookup based on prior bucket
    if "snapshot_lookup_failed" in notes:
        snap, src = lookup_bucket2(cycle, roster_idx, events_by_pid)
    elif "offseason_drop" in notes or "w1_drop" in notes:
        snap, src = lookup_offseason_or_w1(cycle, roster_idx, events_by_pid)
    else:
        snap, src = None, "unknown_bucket"

    if snap is None:
        return {
            "cycle_id": cid, "deferred": src,
            "weeks_active": weeks_active, "restructure_overlap": rs_in_window,
        }

    # Parse snapshot
    raw_salary_str = snap.get("salary")
    raw_salary = int(float(raw_salary_str)) if raw_salary_str else None
    raw_status = snap.get("contractStatus", "") or ""
    raw_ci = snap.get("contractInfo", "") or ""
    raw_cy = snap.get("contractYear")
    cy_remaining = int(raw_cy) if raw_cy else None
    parsed = parse_contract_info(raw_ci)

    contract_type_can = normalize_status(raw_status)

    # Tag-family CL guard (per Section 1.C9 + parser fix A)
    if contract_type_can in TAG_FAMILY:
        cl = 1
    else:
        cl = parsed["contract_length"] or max(cy_remaining or 1, 1)
    if cl < 1:
        cl = 1

    tcv = parsed["tcv"]
    if tcv is None and parsed["year_salaries"]:
        tcv = sum(parsed["year_salaries"])
    elif tcv is None and raw_salary and cl:
        tcv = raw_salary * cl

    if tcv is None:
        return {
            "cycle_id": cid, "deferred": "pass4_tcv_unknown",
            "weeks_active": weeks_active, "restructure_overlap": rs_in_window,
        }

    actual_paid, _ = derive_actual_paid(tcv, parsed["year_salaries"], raw_salary, cl, cy_remaining)
    contract_type_calc = CALC_CONTRACT_TYPE[contract_type_can]

    # For offseason / W=1 drops, drop_week may be NULL — set to 1 for calculator
    drop_week_for_calc = int(cycle["drop_week"]) if cycle.get("drop_week") else 1

    cycle_season = int(cycle["season"])
    eff_acq_week = 1 if drop_year != cycle_season else max(1, int(cycle["acquisition_week"]))
    n_weeks = REG_SEASON_WEEKS[drop_year]
    total_eligible = max(0, n_weeks - eff_acq_week + 1)

    inputs = cp.CycleInputs(
        player_id=pid, franchise_id=fid, season=drop_year,
        acquisition_path=cycle["acquisition_path"],
        acquisition_week=eff_acq_week, contract_type=contract_type_calc,
        drop_date=drop_dt_et, drop_week=drop_week_for_calc,
        drop_reason=cycle["drop_reason"],
        salary_at_drop_usd=raw_salary or 0, tcv_at_drop_usd=tcv,
        contract_years_remaining=cy_remaining or 1,
        original_tcv_usd=tcv, actual_paid_total_usd=actual_paid,
        weeks_active=weeks_active, total_eligible_weeks=total_eligible,
        contract_was_grandfathered=parsed["gf_flag"],
        contract_original_length_years=cl,
    )
    outputs = cp.compute_cycle(inputs)

    return {
        "cycle_id": cid, "deferred": None,
        "snap_source": src, "restructure_overlap": rs_in_window,
        "weeks_active": weeks_active,
        "contract_was_grandfathered_at_drop": 1 if parsed["gf_flag"] else 0,
        "salary_at_drop_usd": raw_salary,
        "tcv_at_drop_usd": tcv,
        "rule_era_at_drop": outputs.rule_era_at_drop,
        "contract_type_at_acquisition": contract_type_can,
        "earned_legacy_usd": outputs.earned_legacy_usd,
        "penalty_legacy_usd": outputs.penalty_legacy_usd,
        "legacy_was_cap_free": 1 if outputs.cap_free else 0,
        "legacy_cap_free_reason": outputs.cap_free_reason,
        "earned_pre2019_usd": outputs.earned_pre2019_usd,
        "earned_calendar_monthly_usd": outputs.earned_calendar_monthly_usd,
        "earned_per_week_usd": outputs.earned_per_week_usd,
        "penalty_pre2019_usd": outputs.penalty_pre2019_usd,
        "penalty_calendar_monthly_usd": outputs.penalty_calendar_monthly_usd,
        "penalty_per_week_usd": outputs.penalty_per_week_usd,
    }


# ---------------------------------------------------------------------------
# D1 UPDATE
# ---------------------------------------------------------------------------

def _sql_lit(v) -> str:
    if v is None or v == "":
        return "NULL"
    if isinstance(v, bool):
        return "1" if v else "0"
    if isinstance(v, (int, float)):
        return str(v)
    s = str(v).replace("'", "''")
    return f"'{s}'"


def merge_notes(existing_notes: Optional[str], pass4_outcome: str,
                restructure_overlap: list) -> Optional[str]:
    """Strip pass3_deferred_* tokens; add pass4 outcome; preserve other tokens."""
    if existing_notes:
        tokens = [t.strip() for t in existing_notes.split(";") if t.strip()]
        tokens = [t for t in tokens if not t.startswith("pass3_deferred")]
    else:
        tokens = []
    if pass4_outcome:
        tokens.append(pass4_outcome)
    if restructure_overlap:
        tokens.append("pass4_restructure_overlap_in_window")
    return "; ".join(tokens) if tokens else None


def build_update_sql(result: dict, existing_notes: Optional[str], now_utc: str) -> str:
    cid = result["cycle_id"]
    overlap = result.get("restructure_overlap") or []
    if result.get("deferred"):
        notes = merge_notes(existing_notes, result["deferred"], overlap)
        return (
            f"UPDATE player_acquisition_cycles SET "
            f"weeks_active = {_sql_lit(result.get('weeks_active', 0))}, "
            f"updated_at_utc = {_sql_lit(now_utc)}, "
            f"source = {_sql_lit(SOURCE_TAG)}, "
            f"notes = {_sql_lit(notes)} "
            f"WHERE cycle_id = {cid};"
        )
    notes = merge_notes(existing_notes, "pass4_complete", overlap)
    cols = [
        ("weeks_active", result["weeks_active"]),
        ("contract_was_grandfathered_at_drop", result["contract_was_grandfathered_at_drop"]),
        ("salary_at_drop_usd", result["salary_at_drop_usd"]),
        ("tcv_at_drop_usd", result["tcv_at_drop_usd"]),
        ("rule_era_at_drop", result["rule_era_at_drop"]),
        ("contract_type_at_acquisition", result["contract_type_at_acquisition"]),
        ("earned_legacy_usd", result["earned_legacy_usd"]),
        ("penalty_legacy_usd", result["penalty_legacy_usd"]),
        ("legacy_was_cap_free", result["legacy_was_cap_free"]),
        ("legacy_cap_free_reason", result["legacy_cap_free_reason"]),
        ("earned_pre2019_usd", result["earned_pre2019_usd"]),
        ("earned_calendar_monthly_usd", result["earned_calendar_monthly_usd"]),
        ("earned_per_week_usd", result["earned_per_week_usd"]),
        ("penalty_pre2019_usd", result["penalty_pre2019_usd"]),
        ("penalty_calendar_monthly_usd", result["penalty_calendar_monthly_usd"]),
        ("penalty_per_week_usd", result["penalty_per_week_usd"]),
        ("updated_at_utc", now_utc),
        ("source", SOURCE_TAG),
        ("notes", notes),
    ]
    set_clause = ", ".join(f"{k} = {_sql_lit(v)}" for k, v in cols)
    return f"UPDATE player_acquisition_cycles SET {set_clause} WHERE cycle_id = {cid};"


def write_to_d1(results: list, existing_notes_by_cid: dict) -> None:
    now_utc = datetime.now().strftime("%Y-%m-%dT%H:%M:%SZ")
    total = len(results)
    print(f"\nWriting {total} cycle UPDATEs to D1 in batches of {D1_BATCH_SIZE}...")
    n_batches = (total + D1_BATCH_SIZE - 1) // D1_BATCH_SIZE
    t0 = time.time()
    for i in range(0, total, D1_BATCH_SIZE):
        batch = results[i:i + D1_BATCH_SIZE]
        sql_lines = [build_update_sql(r, existing_notes_by_cid.get(r["cycle_id"]), now_utc)
                     for r in batch]
        batch_path = STAGE_DIR / f"pass4_d1_batch_{i:06d}.sql"
        batch_path.write_text("\n".join(sql_lines) + "\n")
        batch_idx = i // D1_BATCH_SIZE + 1
        print(f"  batch {batch_idx}/{n_batches}, {min(i+D1_BATCH_SIZE, total)}/{total} rows...")
        result = subprocess.run(
            ["npx", "wrangler", "d1", "execute", "ups-mfl-db", "--remote",
             f"--file={batch_path}"],
            cwd=str(REPO_ROOT / "worker"),
            capture_output=True, text=True,
        )
        if result.returncode != 0:
            print(f"  ✘ Batch {batch_idx} FAILED:\n{result.stderr[:2000]}")
            raise RuntimeError(f"D1 batch {batch_idx} failed")
    elapsed = time.time() - t0
    print(f"✓ Wrote {total} cycle UPDATEs in {elapsed:.1f}s")


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--apply", action="store_true",
                    help="Write UPDATEs to D1 (default: dry-run)")
    args = ap.parse_args()

    print("Pass 4 deferred-cycle enrichment\n")

    print("Loading API-fetched JSON snapshots ...")
    roster_idx = load_roster_index()
    print(f"  {len(roster_idx)} (year, week) snapshots loaded "
          f"(includes 2019 W=16 fetched 2026-05-09)")

    print("Loading canonical events (2019-2024) ...")
    events_by_pid = load_canonical_events_by_pid()
    print(f"  events for {len(events_by_pid)} distinct players")

    print("Loading restructure submissions ...")
    restructures = load_restructures()
    n_subs = sum(len(v) for v in restructures.values())
    print(f"  {n_subs} restructure submissions")

    print("\nQuerying D1 for Pass 3-deferred cycles ...")
    cycles = query_d1_deferred()
    print(f"  {len(cycles)} cycles in scope")

    existing_notes_by_cid = {c["cycle_id"]: c.get("notes") for c in cycles}

    print("\nEnriching each cycle ...")
    results = []
    bucket_counts = defaultdict(int)
    n_overlap = 0
    for c in cycles:
        r = enrich_one(c, roster_idx, events_by_pid, restructures)
        results.append(r)
        if r.get("deferred"):
            bucket_counts[r["deferred"]] += 1
        else:
            bucket_counts["pass4_complete"] += 1
        if r.get("restructure_overlap"):
            n_overlap += 1

    print("\n" + "=" * 60)
    print("ENRICHMENT SUMMARY")
    print("=" * 60)
    for bucket, n in sorted(bucket_counts.items(), key=lambda kv: -kv[1]):
        print(f"  {n:>5}  {bucket}")
    print(f"  {n_overlap:>5}  (also flagged: pass4_restructure_overlap_in_window)")
    print(f"  {len(results):>5}  TOTAL")

    if not args.apply:
        print("\n[DRY-RUN] No D1 writes. Use --apply to push.")
        return

    write_to_d1(results, existing_notes_by_cid)
    print("\nPass 4 complete.")


if __name__ == "__main__":
    main()
