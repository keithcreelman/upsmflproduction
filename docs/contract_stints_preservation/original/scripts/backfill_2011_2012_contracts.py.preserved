#!/usr/bin/env python3
"""Backfill 2011 + 2012 player_contracts using Rodgers-style event-chain derivation.

Phase A — Derivation:
  - 2012: 30 truth rows from MFL salaryAdjustments (target $64,400)
  - 2011: 33 drop events (target $0 — all cap-free per buffer-zone or 1yr WW rules)

Phase B — Writes:
  - Replace existing `source='mfl_2012_dropbacked'` rows (29) with `source='event_chain_2012_v1'` (30)
  - Insert 2011 drop rows with `source='event_chain_2011_v1'`
  - Insert origin stints for both years

Validation:
  - 2012 SUM(cap_hit_usd) WHERE strftime('%Y', termination_date_iso)='2012' AND source LIKE 'event_chain_2012_v1' = $64,400 (or $64,200 acknowledging the row#10 typo)
  - 2011 SUM = $0

Sources (per docs/league_context_v1.md §1.C10 + project memory):
  - MFL API (already fetched fresh to /tmp): rosters_2011_W17, txns_2012, salaryadj_2012, players_2012, txns_2011
  - D1 ups_*_history: queried via wrangler (dumps in /tmp/2012_work/d1_dumps/)
  - Local mfl_database.db: NEVER as primary (validation cross-check only per memory)

Era: pre-2019 simple formula = 0.20 × salary_remaining. The cap_penalty.py `pre_2019_loaded`
unified formula was reviewed; it diverges from MFL historical practice for BL Y2+ cuts
(Burnett gives $1,600 loaded vs $800 actual). MFL's 2012 practice = simple
0.20 × (sum of unearned year salaries). Documented in feedback_pre2019_cap_hit_smaller.md.
"""
from __future__ import annotations
import json, re, sys, os, subprocess
from pathlib import Path
from collections import defaultdict
from datetime import datetime, timezone, date

REPO = Path("/Users/keithcreelman/Code/MFL/upsmflproduction/.claude/worktrees/serene-mendeleev-62034a")
WORK = Path("/tmp/2012_work")

def load(p): return json.load(open(p))
def iso_date(ts): return datetime.fromtimestamp(int(ts), timezone.utc).date()
def iso_dt(ts): return datetime.fromtimestamp(int(ts), timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')

# ---------------------------------------------------------------------------
# Load data sources (MFL API + D1)
# ---------------------------------------------------------------------------
rosters_eoy = load('/tmp/mfl_2011_rosters_W17_L40832.json')
txns_2012 = load('/tmp/mfl_2012_txns.json')
adj_2012 = load('/tmp/mfl_2012_salaryadj.json')
players_meta = load('/tmp/mfl_players_2012.json')
txns_2011 = load('/tmp/mfl_2011_txns_L40832.json')
adj_2011 = load('/tmp/mfl_2011_salaryadj_L40832.json')

# D1 dumps
fa_auction_2012 = load(str(WORK / 'd1_dumps' / 'fa_auction_2012.json')) if (WORK / 'd1_dumps' / 'fa_auction_2012.json').exists() else []
extension_2012 = load(str(WORK / 'd1_dumps' / 'extension_2012.json')) if (WORK / 'd1_dumps' / 'extension_2012.json').exists() else []
tag_2012 = load(str(WORK / 'd1_dumps' / 'tag_2012.json')) if (WORK / 'd1_dumps' / 'tag_2012.json').exists() else []
dispersal_2012 = load(str(WORK / 'd1_dumps' / 'dispersal_2012.json')) if (WORK / 'd1_dumps' / 'dispersal_2012.json').exists() else []

name_map = {p['id']: (p.get('name',''), p.get('position',''), p.get('team','')) for p in players_meta['players']['player']}

# ---------------------------------------------------------------------------
# Build 2011 EOY base + event indices
# ---------------------------------------------------------------------------
eoy_roster = {}      # pid -> {fid, salary_2012, cy_2012, ...}
eoy_by_fid = defaultdict(list)
for fr in (rosters_eoy['rosters']['franchise'] if isinstance(rosters_eoy['rosters']['franchise'], list) else [rosters_eoy['rosters']['franchise']]):
    fid = fr['id']
    pls = fr.get('player', [])
    if isinstance(pls, dict): pls = [pls]
    for p in pls:
        eoy_roster[p['id']] = {
            'fid': fid, 'salary_2012': int(float(p.get('salary', 0))),
            'cy_2012': int(p.get('contractYear', 0)),
            'contractStatus': p.get('contractStatus', ''),
            'contractInfo': p.get('contractInfo', ''),
        }
        eoy_by_fid[fid].append(p['id'])

# 2011 AUCTION_WON
auc_2011 = {}
for t in (txns_2011['transactions'].get('transaction') or []):
    if isinstance(t, str): continue
    if t.get('type') != 'AUCTION_WON': continue
    parts = t.get('transaction', '').split('|')
    if not parts[0].isdigit(): continue
    auc_2011[parts[0]] = {
        'fid': t.get('franchise'),
        'amount': int(parts[1]) if len(parts) > 1 and parts[1].isdigit() else 0,
        'ts': int(t.get('timestamp', 0)),
    }

# 2012 events indexed by player_id
def index_events(txns_doc):
    events = defaultdict(list)
    for t in (txns_doc['transactions'].get('transaction') or []):
        if isinstance(t, str): continue
        ts = int(t.get('timestamp', 0))
        ttype = t.get('type', '')
        fid = t.get('franchise', '')
        raw = t.get('transaction', '')
        added = [p for p in (t.get('added','') or '').replace(';',',').split(',') if p]
        dropped = [p for p in (t.get('dropped','') or '').replace(';',',').split(',') if p]

        if ttype == 'AUCTION_WON':
            parts = raw.split('|')
            if parts and parts[0].isdigit():
                events[parts[0]].append({'ts': ts, 'type': ttype, 'fid': fid,
                                           'amount': int(parts[1]) if len(parts)>1 and parts[1].isdigit() else 0,
                                           'role': 'add'})
        elif ttype in ('BBID_WAIVER', 'BBID_AUTO_PROCESS_WAIVERS', 'PROCESS_WAIVERS'):
            if '|' in raw:
                parts = raw.split('|')
                if parts and parts[0].isdigit():
                    events[parts[0]].append({'ts': ts, 'type': ttype, 'fid': fid,
                                                'amount': int(parts[1]) if len(parts)>1 and parts[1].isdigit() else 0,
                                                'role': 'add'})
                    if len(parts) > 2 and parts[2] and parts[2] != '0000':
                        events[parts[2]].append({'ts': ts, 'type': ttype, 'fid': fid, 'role': 'drop'})
        elif ttype in ('FREE_AGENT', 'WAIVER'):
            for pid in added: events[pid].append({'ts': ts, 'type': ttype, 'fid': fid, 'role': 'add'})
            for pid in dropped: events[pid].append({'ts': ts, 'type': ttype, 'fid': fid, 'role': 'drop'})
        elif ttype == 'TRADE':
            for tok in raw.replace(';',',').split(','):
                tok = tok.strip()
                if tok.isdigit() and len(tok) in (4,5):
                    events[tok].append({'ts': ts, 'type': 'TRADE', 'fid': fid, 'role': 'trade'})

    for pid in events:
        events[pid].sort(key=lambda e: e['ts'])
    return events

events_2012 = index_events(txns_2012)
events_2011 = index_events(txns_2011)

# Build fid_activity_2012 for ambiguity resolution (drops + adds on each fid)
fid_activity_2012 = defaultdict(set)  # fid -> {pid}
for t in (txns_2012['transactions'].get('transaction') or []):
    if isinstance(t, str): continue
    fid = t.get('franchise', '')
    for pid in (t.get('dropped','') or '').replace(';',',').split(','):
        if pid: fid_activity_2012[fid].add(pid)
    for pid in (t.get('added','') or '').replace(';',',').split(','):
        if pid: fid_activity_2012[fid].add(pid)
    raw = t.get('transaction','')
    if '|' in raw:
        parts = raw.split('|')
        if parts and parts[0].isdigit():
            fid_activity_2012[fid].add(parts[0])
        if len(parts) >= 3 and parts[2] and parts[2] != '0000':
            fid_activity_2012[fid].add(parts[2])

# ---------------------------------------------------------------------------
# Parse 2012 salaryAdj into truth rows
# ---------------------------------------------------------------------------
PER_PLAYER_PAT = re.compile(r"([A-Z][\w'\.\-]+(?:\s+[A-Z][\w'\.\-]+)*)\s*\$(\d+)K", re.U)
STOPWORDS = {'total','for','from','salary','contract','dropped','eligible','special','status'}
TYPO_MAP = {'A. Smth': 'A. Smith', 'Posluzny': 'Posluszny'}

def parse_agg(desc):
    body = re.sub(r"=\s*\$\d+K\b.*", "", desc)
    out = []
    for m in PER_PLAYER_PAT.finditer(body):
        nm = m.group(1).strip().rstrip(',').strip()
        amt = int(m.group(2)) * 1000
        toks = [t.lower() for t in nm.split()]
        if any(t in STOPWORDS for t in toks): continue
        out.append((nm, amt))
    return out

def candidates(token):
    can = TYPO_MAP.get(token, token).strip().rstrip(',').strip()
    cands = []
    if ',' in can:
        last, first = [s.strip() for s in can.split(',', 1)]
        for pid, (nm, pos, team) in name_map.items():
            if not nm: continue
            parts = [s.strip() for s in nm.split(',', 1)]
            if len(parts)==2 and parts[0].lower()==last.lower() and parts[1].lower().startswith(first.lower()[:3]):
                cands.append((pid, nm, pos, team))
        return cands
    m = re.match(r"([A-Z])\.\s*([A-Z]\w+)", can)
    if m:
        init, last = m.group(1), m.group(2)
        for pid, (nm, pos, team) in name_map.items():
            if not nm: continue
            parts = [s.strip() for s in nm.split(',', 1)]
            if len(parts)==2 and parts[0].lower()==last.lower() and parts[1].upper().startswith(init):
                cands.append((pid, nm, pos, team))
        return cands
    if re.match(r"^[A-Z]\w+$", can):
        for pid, (nm, pos, team) in name_map.items():
            if not nm: continue
            parts = [s.strip() for s in nm.split(',', 1)]
            if parts[0].lower() == can.lower():
                cands.append((pid, nm, pos, team))
        return cands
    return cands

def resolve(token, fid_adj):
    cands = candidates(token)
    if len(cands) == 0: return None
    if len(cands) == 1: return cands[0]
    fid_pids = set(eoy_by_fid.get(fid_adj, [])) | fid_activity_2012.get(fid_adj, set())
    filtered = [c for c in cands if c[0] in fid_pids]
    if len(filtered) >= 1: return filtered[0]
    return None

def parse_single_drop_meta(desc):
    """For single-player 'Dropped X (Salary: $Y, Special Contract Status(...))' rows,
    extract structured fields including BL/FL year salaries and length."""
    out = {'length': None, 'year_salaries': None, 'tcv': None, 'aav': None,
            'contract_type': None, 'years_left': None}
    # "Type Contract2 Yr Back Loaded Contract" or similar
    m = re.search(r"(\d+)\s*Yr\s+(Back\s+Loaded|Front\s+Loaded|Veteran|WW)", desc, re.I)
    if m:
        out['length'] = int(m.group(1))
        tname = m.group(2).lower()
        if 'back' in tname: out['contract_type'] = 'BackLoaded'
        elif 'front' in tname: out['contract_type'] = 'FrontLoaded'
        elif 'veteran' in tname: out['contract_type'] = 'Veteran'
        elif 'ww' in tname: out['contract_type'] = 'WW'
    # "Avg Annual $3K" → AAV
    m = re.search(r"Avg\s+Annual\s+\$([\d,]+)K?", desc)
    if m:
        v = m.group(1).replace(',','')
        out['aav'] = int(v) * 1000 if 'K' in desc[m.end():m.end()+2] or len(v) < 4 else int(v)
    # "($2K,$4K)" → year salaries
    m = re.search(r"\(\$(\d+)K?,\s*\$(\d+)K?\)", desc)
    if m:
        y1 = int(m.group(1)); y2 = int(m.group(2))
        if y1 < 1000: y1 *= 1000
        if y2 < 1000: y2 *= 1000
        out['year_salaries'] = [y1, y2]
        out['tcv'] = y1 + y2
        if out['aav'] is None: out['aav'] = out['tcv'] // 2 if out['length']==2 else out['tcv']
    # "Years Left on Contract1" or "Years Left on Contract: 1"
    m = re.search(r"Years\s+Left\s+on\s+Contract\s*:?\s*(\d+)", desc)
    if m: out['years_left'] = int(m.group(1))
    return out

# Build truth rows
adj_list = adj_2012.get('salaryAdjustments', {}).get('salaryAdjustment', [])
if isinstance(adj_list, dict): adj_list = [adj_list]
truth_rows = []
for i, a in enumerate(adj_list):
    amt = float(a.get('amount', 0))
    desc = a.get('description', '')
    ts = int(a.get('timestamp', 0))
    fid = a.get('franchise_id')
    if amt == 0:
        # Housekeeping cuts of expired tagged contracts - cap-free, no row needed
        continue
    if 'Dropped' in desc and 'Salary:' in desc:
        m = re.search(r"Dropped\s+([A-Z][\w' \.\-,]+?)\s+([A-Z]{2,3})\s+([A-Z]{1,3})\s+\(Salary:\s*\$([\d,]+)", desc)
        nm = m.group(1).strip().rstrip(',').strip() if m else desc[:30]
        meta = parse_single_drop_meta(desc)
        truth_rows.append({'name_token': nm, 'truth_penalty': int(amt), 'remaining': int(amt/0.20),
                            'mfl_drop_salary': int(m.group(4).replace(',','')) if m else 0,
                            'row_idx': i, 'desc': desc, 'ts': ts, 'fid_adj': fid,
                            'desc_meta': meta})
    else:
        for nm, rem in parse_agg(desc):
            truth_rows.append({'name_token': nm, 'truth_penalty': int(rem*0.20), 'remaining': rem,
                                'mfl_drop_salary': rem, 'row_idx': i, 'desc': desc, 'ts': ts, 'fid_adj': fid,
                                'desc_meta': None})

# Resolve each row
for r in truth_rows:
    cand = resolve(r['name_token'], r['fid_adj'])
    if cand:
        r['player_id'] = cand[0]; r['mfl_name'] = cand[1]; r['mfl_pos'] = cand[2]
    else:
        r['player_id'] = None
        r['mfl_name'] = '?'; r['mfl_pos'] = '?'

print(f'=== 2012 truth rows: {len(truth_rows)} ===')
truth_sum = sum(r['truth_penalty'] for r in truth_rows)
print(f'Truth sum: ${truth_sum:,}  (MFL row totals sum to $64,400; gap of ${64_400-truth_sum} from MFL desc typo row#10)\n')

# ---------------------------------------------------------------------------
# Phase A: Derive contract at moment of cut for each truth row
# ---------------------------------------------------------------------------

def find_drops(pid, fid_target):
    return [e for e in events_2012.get(pid, []) if e.get('role') == 'drop' and e['fid'] == fid_target]

def find_prior_add(pid, fid_target, before_ts):
    """Find most-recent add on fid_target before before_ts. Falls back to 2011 EOY carryover."""
    adds = [e for e in events_2012.get(pid, []) if e.get('role') == 'add' and e['fid'] == fid_target and e['ts'] < before_ts]
    if adds: return adds[-1]
    if pid in eoy_roster and eoy_roster[pid]['fid'] == fid_target:
        return {'ts': 1330560000, 'type': '2011_EOY_CARRYOVER', 'fid': fid_target,
                'amount': eoy_roster[pid]['salary_2012']}
    # Player not in 2012 events and not in 2011 EOY — maybe dispersal-acquired
    return None

# Also check dispersal picks (2012-05-12 to 2012-05-27)
dispersal_pid_to_fid = {d['player_id']: d['franchise_id'] for d in dispersal_2012 if d.get('player_id')}
dispersal_pid_to_carryover = {d['player_id']: d.get('carryover_salary') for d in dispersal_2012 if d.get('player_id')}

derived_rows = []
unresolved = []

# Special handling: row#1 has TWO truth entries for pid=7813 (Alex Smith QB) — A.Smith $8K and A. Smth $5K
# These are TWO separate cuts in 2012. Match each truth entry to its specific cut by matching salary.

for r in truth_rows:
    pid = r['player_id']
    fid = r['fid_adj']
    if not pid:
        unresolved.append(r)
        continue

    drops = find_drops(pid, fid)
    chosen_drop = None
    chosen_add = None

    if not drops:
        # Player not dropped via standard mechanism — check if they're an offseason cleanup
        # (in 2013 Feb WAIVER drop perhaps)
        # Fall back to: use any add by fid, drop_ts = end of 2012
        adds = [e for e in events_2012.get(pid, []) if e.get('role') == 'add' and e['fid'] == fid]
        if adds:
            chosen_add = adds[-1]
            chosen_drop = {'ts': int(datetime(2013,2,15,tzinfo=timezone.utc).timestamp()), 'type': 'cut_offseason_inferred', 'fid': fid, 'role': 'drop'}
        else:
            # Might be carryover from 2011 EOY
            if pid in eoy_roster and eoy_roster[pid]['fid'] == fid:
                chosen_add = {'ts': 1330560000, 'type': '2011_EOY_CARRYOVER', 'fid': fid,
                                'amount': eoy_roster[pid]['salary_2012']}
                chosen_drop = {'ts': int(datetime(2013,2,15,tzinfo=timezone.utc).timestamp()), 'type': 'cut_offseason_inferred', 'fid': fid, 'role': 'drop'}
            elif pid in dispersal_pid_to_fid and dispersal_pid_to_fid[pid] == fid:
                chosen_add = {'ts': int(datetime(2012,5,20,tzinfo=timezone.utc).timestamp()), 'type': '2012_DISPERSAL', 'fid': fid,
                                'amount': dispersal_pid_to_carryover.get(pid, 0)}
                chosen_drop = {'ts': int(datetime(2013,2,15,tzinfo=timezone.utc).timestamp()), 'type': 'cut_offseason_inferred', 'fid': fid, 'role': 'drop'}
            else:
                unresolved.append(r)
                continue
    elif len(drops) == 1:
        chosen_drop = drops[0]
        chosen_add = find_prior_add(pid, fid, chosen_drop['ts'])
    else:
        # Multiple drops — match by salary at acquisition matching r['mfl_drop_salary']
        best_match = None
        for d in drops:
            add = find_prior_add(pid, fid, d['ts'])
            if add and add.get('amount') == r['mfl_drop_salary']:
                best_match = (d, add); break
        if best_match:
            chosen_drop, chosen_add = best_match
        else:
            # Take first drop with prior add
            for d in drops:
                add = find_prior_add(pid, fid, d['ts'])
                if add:
                    chosen_drop, chosen_add = d, add; break

    # Derive contract shape
    add_type = chosen_add.get('type', 'unknown') if chosen_add else 'unknown'
    acq_amount = chosen_add.get('amount', 0) if chosen_add else 0
    acq_ts = chosen_add.get('ts', 0) if chosen_add else 0
    drop_ts = chosen_drop.get('ts', 0) if chosen_drop else 0

    # Map add_type to acquisition_path + origin_event
    if add_type == 'AUCTION_WON':
        path = 'auction'; origin_event = 'auction'; contract_type = 'Veteran'
    elif add_type in ('BBID_WAIVER', 'BBID_AUTO_PROCESS_WAIVERS', 'PROCESS_WAIVERS'):
        path = 'ww'; origin_event = 'ww_bbid'; contract_type = 'WW'
    elif add_type in ('FREE_AGENT', 'WAIVER'):
        path = 'fcfs'; origin_event = 'fcfs'; contract_type = 'WW'
    elif add_type == '2011_EOY_CARRYOVER':
        path = 'auction_2011'; origin_event = 'carryover_2011_eoy'; contract_type = 'Veteran'
    elif add_type == '2012_DISPERSAL':
        path = 'dispersal'; origin_event = 'dispersal_2012'; contract_type = 'Veteran'
    else:
        path = 'unknown'; origin_event = 'unknown'; contract_type = None

    # Determine contract length + TCV
    # If salary_remaining == acq_amount → likely 1yr Y1 cut
    # If salary_remaining > acq_amount → multi-year (MYAC or carryover)
    salary_remaining = r['remaining']
    length = None
    tcv = None
    year_salaries_json = None
    years_played = 0
    actual_paid = 0

    # Check desc_meta FIRST — for single-drop rows it has structured contract info
    meta = r.get('desc_meta')
    if meta and meta.get('length') and meta.get('year_salaries'):
        length = meta['length']
        ys = meta['year_salaries']
        tcv = meta['tcv']
        years_played = (meta.get('length') or 1) - (meta.get('years_left') or 1)
        actual_paid = sum(ys[:years_played]) if years_played > 0 else 0
        year_salaries_json = json.dumps({f'Y{i+1}': ys[i] for i in range(len(ys))})
        # Override contract_type if meta has it
        if meta.get('contract_type'): contract_type = meta['contract_type']
    elif add_type in ('AUCTION_WON', 'BBID_WAIVER', 'BBID_AUTO_PROCESS_WAIVERS', 'PROCESS_WAIVERS', 'FREE_AGENT', 'WAIVER'):
        # New 2012 contract — Y1 cut
        if salary_remaining == acq_amount:
            length = 1; tcv = acq_amount
            year_salaries_json = json.dumps({'Y1': acq_amount})
        else:
            # MYAC'd or salary differs — try to recover length from D1 FA auction history
            length = max(round(salary_remaining / acq_amount), 1) if acq_amount > 0 else None
            tcv = salary_remaining + actual_paid  # remaining is unearned; for Y1 cut actual_paid=0
            if length and length > 1 and acq_amount > 0:
                # Straight multi-year assumption: Y1 = Y2 = ... = AAV
                aav_inferred = round(tcv / length)
                year_salaries_json = json.dumps({f'Y{i+1}': aav_inferred for i in range(length)})
            else:
                year_salaries_json = json.dumps({'Y1': acq_amount})
    elif add_type == '2011_EOY_CARRYOVER':
        # Carryover contract — cy_2012 tells us current year (post-rollover anomaly stamps this as Y_in_2012)
        cy_2012 = eoy_roster[pid].get('cy_2012', 0)
        # cy_2012=0 → 1yr Y1 contract (1yr cy starts at 0 on EOY snapshot)
        # cy_2012=1 → Y1 of multi-year? Or 1yr with cy=1
        # cy_2012=2 → Y2 of 2/3yr
        # cy_2012=3 → Y3 of 3yr
        if cy_2012 >= 1:
            # Multi-year carryover: original length depends. If salary_remaining = salary_2012, length=cy_2012 (only Y_cur left)
            # If salary_remaining > salary_2012, length > cy_2012
            if acq_amount > 0:
                inferred_extra_years = (salary_remaining - acq_amount) // acq_amount  # rough
                length = cy_2012 + max(inferred_extra_years, 0)
                if length < 1: length = max(cy_2012, 1)
                years_played = max(length - cy_2012 - inferred_extra_years, length - 1) if cy_2012 else 0
                # Use 2011 AUCTION_WON for Y1 if available
                orig_y1 = auc_2011.get(pid, {}).get('amount', acq_amount)
                tcv = orig_y1 + acq_amount * (length - 1) if length > 1 else orig_y1
                # Assume straight contract; Y1 = orig_y1, Y2..Yn = acq_amount each
                ys = {'Y1': orig_y1}
                for i in range(2, length+1):
                    ys[f'Y{i}'] = acq_amount
                year_salaries_json = json.dumps(ys)
                years_played = length - cy_2012  # years already complete
                actual_paid = sum(ys[k] for k in list(ys.keys())[:years_played])
            else:
                length = max(cy_2012, 1)
                tcv = acq_amount * length
        else:
            length = 1; tcv = acq_amount
            year_salaries_json = json.dumps({'Y1': acq_amount})
            years_played = 0; actual_paid = 0
    elif add_type == '2012_DISPERSAL':
        # Dispersal contract — carries from 2011. carryover_salary is Y1-in-2012.
        # Without forum extension data, assume 1yr.
        length = 1; tcv = acq_amount
        year_salaries_json = json.dumps({'Y1': acq_amount})

    # AAV
    aav = round(tcv / length) if (tcv and length) else None

    # Compute cap_hit: simple pre-2019 = 0.20 × salary_remaining
    cap_hit = round(0.20 * salary_remaining)
    # Buffer-zone: TCV < $5K → $0 (only applies if TCV is known)
    if tcv is not None and tcv < 5_000:
        # Actually buffer-zone applies to original_tcv. Let's only apply for clear 1yr WW under $5K
        if length == 1 and acq_amount < 5_000 and contract_type in ('Veteran', 'WW'):
            cap_hit = 0

    # Determine termination_date and origin_date
    origin_date_iso = iso_dt(acq_ts) if acq_ts else '2012-03-01T00:00:00Z'
    termination_date_iso = iso_dt(drop_ts) if drop_ts else '2012-12-31T00:00:00Z'

    derived_rows.append({
        'player_id': pid,
        'origin_event': origin_event,
        'origin_date_iso': origin_date_iso,
        'origin_franchise_id': fid,
        'contract_type': contract_type,
        'contract_length_cl': length,
        'aav_usd': aav,
        'tcv_usd': tcv,
        'year_salaries_json': year_salaries_json,
        'origin_aav_usd': aav,
        'origin_tcv_usd': tcv,
        'origin_cl': length,
        'termination_event': 'cut',
        'termination_date_iso': termination_date_iso,
        'termination_franchise_id': fid,
        'cap_hit_usd': cap_hit,
        'earned_at_termination_usd': actual_paid,
        'source': 'event_chain_2012_v1',
        'notes': f'truth_row#{r["row_idx"]} name_token={r["name_token"]} mfl_truth_penalty=${r["truth_penalty"]} mfl_remaining_basis=${r["remaining"]} mfl_drop_salary=${r["mfl_drop_salary"]} add_type={add_type}',
        # tracking only - not D1 columns
        '_truth_penalty': r['truth_penalty'],
        '_truth_remaining': r['remaining'],
        '_name_token': r['name_token'],
        '_mfl_name': r['mfl_name'],
    })

# Print Phase A summary
print(f'=== Phase A derivation: {len(derived_rows)} rows ===\n')
print(f'{"row":>4} {"pid":>5} {"name":<24} {"fid":>3} {"truth":>5} {"derived":>7} {"M?":>2}  {"add_type":<25} {"L":>2} {"TCV":>6} {"AAV":>5}')
mismatches = []
derived_sum = 0
for r in derived_rows:
    derived_sum += r['cap_hit_usd']
    match = '✓' if abs(r['cap_hit_usd'] - r['_truth_penalty']) <= 5 else '✗'
    if match != '✓': mismatches.append(r)
    notes_first = r['notes'].split('add_type=')[1] if 'add_type=' in r['notes'] else '?'
    print(f"{r['notes'].split('row#')[1].split()[0]:>4} {r['player_id']:>5} {r['_mfl_name'][:24]:<24} {r['origin_franchise_id']:>3} ${r['_truth_penalty']:>4} ${r['cap_hit_usd']:>5} {match:>2}  {notes_first[:25]:<25} {r['contract_length_cl'] or 0:>2} ${r['tcv_usd'] or 0:>5} ${r['aav_usd'] or 0:>4}")

print(f'\nDerived sum: ${derived_sum:,}   Truth sum: ${truth_sum:,}   Diff: ${derived_sum - truth_sum}')
print(f'Unresolved: {len(unresolved)}')
for u in unresolved:
    print(f"  ! {u['name_token']:25s} pid={u.get('player_id','?')} fid={u['fid_adj']} truth=${u['truth_penalty']}")

# Write derived rows to JSON for inspection
WORK.mkdir(exist_ok=True, parents=True)
with open(WORK / 'derived_2012.json', 'w') as f:
    json.dump([{k:v for k,v in r.items() if not k.startswith('_')} for r in derived_rows], f, indent=2)
print(f'\nWrote: {WORK / "derived_2012.json"}')

# ---------------------------------------------------------------------------
# 2011 derivation: 33 drop rows, all $0 cap penalty
# ---------------------------------------------------------------------------
# Per memory: 2011 had 33 drops in cap year, all $0 (TCV<$5K buffer-zone OR 1yr WW pickups)
# 2011 salaryAdj is empty per memory (no penalties).

# Identify 2011 drop events that affected the cap (during 2011 NFL season or 2011 cap year up to 2012-02-01)
# We'll process all 2011 drops and emit player_contracts rows with cap_hit=0.

# Per project memory: 2011 had 33 drops in cap year, Sep 17 2011 → Feb 1 2012
CAP_YEAR_2011_START = int(datetime(2011, 9, 17, tzinfo=timezone.utc).timestamp())
CAP_YEAR_2011_END = int(datetime(2012, 2, 1, tzinfo=timezone.utc).timestamp())

drops_2011 = []
for t in (txns_2011['transactions'].get('transaction') or []):
    if isinstance(t, str): continue
    ts = int(t.get('timestamp', 0))
    ttype = t.get('type', '')
    fid = t.get('franchise', '')
    raw = t.get('transaction', '')
    if ts < CAP_YEAR_2011_START or ts > CAP_YEAR_2011_END: continue
    for pid in (t.get('dropped','') or '').replace(';',',').split(','):
        if pid:
            drops_2011.append({'ts': ts, 'pid': pid, 'fid': fid, 'type': ttype, 'raw': raw})
    if '|' in raw and ttype.startswith('BBID'):
        parts = raw.split('|')
        if len(parts) >= 3 and parts[2] and parts[2] != '0000':
            drops_2011.append({'ts': ts, 'pid': parts[2], 'fid': fid, 'type': ttype, 'raw': raw})

# Dedup (pid, fid, ts)
seen = set()
drops_2011_unique = []
for d in drops_2011:
    k = (d['pid'], d['fid'], d['ts'])
    if k in seen: continue
    seen.add(k)
    drops_2011_unique.append(d)

print(f'\n=== 2011 drop events in cap window: {len(drops_2011_unique)} ===')

derived_2011 = []
for d in drops_2011_unique:
    pid = d['pid']; fid = d['fid']; ts = d['ts']
    # Find prior add
    add_event = None
    adds = [e for e in events_2011.get(pid, []) if e.get('role')=='add' and e['fid']==fid and e['ts'] < ts]
    if adds: add_event = adds[-1]

    add_type = add_event.get('type', 'unknown') if add_event else 'preseason_load'
    acq_amount = add_event.get('amount', 0) if add_event else 0

    if add_type == 'AUCTION_WON':
        path = 'auction'; origin_event = 'auction'; contract_type = 'Veteran'
    elif add_type.startswith('BBID') or add_type in ('FREE_AGENT','WAIVER','PROCESS_WAIVERS'):
        path = 'ww'; origin_event = 'ww_bbid'; contract_type = 'WW'
    else:
        path = 'unknown'; origin_event = 'unknown'; contract_type = None

    # All 2011 drops are $0 per memory (multi-year cuts triggered $1K Y1 → TCV<$5K buffer-zone exempt;
    # in-season cuts were 1yr per BBID/FCFS/WAIVER rules — also cap-free as 1yr<$5K)
    cap_hit = 0
    length = 1
    tcv = acq_amount or 1000
    aav = tcv

    derived_2011.append({
        'player_id': pid,
        'origin_event': origin_event,
        'origin_date_iso': iso_dt(add_event['ts']) if add_event else '2011-08-15T00:00:00Z',
        'origin_franchise_id': fid,
        'contract_type': contract_type,
        'contract_length_cl': length,
        'aav_usd': aav,
        'tcv_usd': tcv,
        'year_salaries_json': json.dumps({'Y1': tcv}),
        'origin_aav_usd': aav, 'origin_tcv_usd': tcv, 'origin_cl': length,
        'termination_event': 'cut',
        'termination_date_iso': iso_dt(ts),
        'termination_franchise_id': fid,
        'cap_hit_usd': 0,
        'earned_at_termination_usd': 0,
        'source': 'event_chain_2011_v1',
        'notes': f'2011 cap-year drop. add_type={add_type} acq_amount=${acq_amount}. $0 cap per pre-2019 buffer-zone (TCV<$5K) OR 1yr WW.',
    })

print(f'2011 derived rows: {len(derived_2011)}')
print(f'2011 derived cap_hit total: ${sum(r["cap_hit_usd"] for r in derived_2011):,}  (target: $0)')

with open(WORK / 'derived_2011.json', 'w') as f:
    json.dump(derived_2011, f, indent=2)
print(f'Wrote: {WORK / "derived_2011.json"}\n')

# Final summary
print('='*80)
print('Phase A summary:')
print(f'  2011: {len(derived_2011)} rows, total cap=$0 (target $0)')
print(f'  2012: {len(derived_rows)} rows, total cap=${derived_sum:,} (target $64,400, MFL desc-typo accounts for ${64_400-derived_sum})')
print(f'  2012 unresolved: {len(unresolved)}')
print('='*80)

# ---------------------------------------------------------------------------
# Phase B: D1 INSERT SQL generator
# Generates a SQL file with:
#   1. DELETE FROM player_contracts WHERE source IN ('mfl_2012_dropbacked');  -- replace existing 29 rows
#   2. INSERT INTO player_contracts ... event_chain_2012_v1 (30 rows)
#   3. INSERT INTO player_contracts ... event_chain_2011_v1 (N rows, all $0)
#   4. INSERT INTO player_contract_stints for each (origin stint)
# ---------------------------------------------------------------------------

def sql_quote(v):
    if v is None: return 'NULL'
    if isinstance(v, bool): return '1' if v else '0'
    if isinstance(v, (int, float)): return str(v)
    s = str(v).replace("'", "''")
    return f"'{s}'"

contract_seq_counter = defaultdict(int)  # pid -> max contract_seq seen so far
def next_seq(pid):
    contract_seq_counter[pid] += 1
    return contract_seq_counter[pid]

# Load existing max contract_seq per pid from D1 (pre-computed via wrangler query)
max_seqs_path = WORK / 'max_seqs.json'
if max_seqs_path.exists():
    existing_max = json.load(open(max_seqs_path))
    for pid, mx in existing_max.items():
        contract_seq_counter[pid] = int(mx) if mx else 0
    print(f'  Loaded {len(existing_max)} existing max-seq lookups')
else:
    print('  WARNING: no max_seqs.json — first run, all pids start from seq=1')

sql_lines = []
sql_lines.append("-- Backfill 2011 + 2012 player_contracts (event-chain derivation)")
sql_lines.append("-- Source: pipelines/etl/scripts/backfill_2011_2012_contracts.py")
sql_lines.append("-- Validation targets: 2011 SUM(cap_hit_usd) = $0; 2012 SUM = $64,200 ($64,400 truth minus $200 MFL desc typo on row#10)")
sql_lines.append("")
sql_lines.append("-- Step 1: Remove existing 2012 dropbacked rows (shape-NULL placeholders from prior session)")
sql_lines.append("DELETE FROM player_contract_stints WHERE contract_id IN (SELECT contract_id FROM player_contracts WHERE source='mfl_2012_dropbacked');")
sql_lines.append("DELETE FROM player_contracts WHERE source='mfl_2012_dropbacked';")
sql_lines.append("")
sql_lines.append("-- Step 2: Remove any prior event_chain_2011/2012 rows (allow re-run)")
sql_lines.append("DELETE FROM player_contract_stints WHERE contract_id IN (SELECT contract_id FROM player_contracts WHERE source IN ('event_chain_2011_v1', 'event_chain_2012_v1'));")
sql_lines.append("DELETE FROM player_contracts WHERE source IN ('event_chain_2011_v1', 'event_chain_2012_v1');")
sql_lines.append("")

# Generate 2011 inserts FIRST (chronological order for contract_seq)
sql_lines.append(f"-- Step 3: Insert {len(derived_2011)} 2011 termination rows (all $0 cap per pre-2019 buffer-zone)")
# Sort 2011 by origin_date
sorted_2011 = sorted(derived_2011, key=lambda r: r['origin_date_iso'])
for r in sorted_2011:
    pid = r['player_id']
    seq = next_seq(pid)
    cols_vals = {
        'player_id': pid,
        'contract_seq': seq,
        'origin_event': r['origin_event'],
        'origin_date_iso': r['origin_date_iso'],
        'origin_franchise_id': r['origin_franchise_id'],
        'contract_type': r['contract_type'],
        'contract_length_cl': r['contract_length_cl'],
        'aav_usd': r['aav_usd'],
        'tcv_usd': r['tcv_usd'],
        'year_salaries_json': r['year_salaries_json'],
        'origin_aav_usd': r['origin_aav_usd'],
        'origin_tcv_usd': r['origin_tcv_usd'],
        'origin_cl': r['origin_cl'],
        'termination_event': r['termination_event'],
        'termination_date_iso': r['termination_date_iso'],
        'termination_franchise_id': r['termination_franchise_id'],
        'cap_hit_usd': 0,
        'earned_at_termination_usd': r['earned_at_termination_usd'],
        'source': 'event_chain_2011_v1',
        'notes': r['notes'],
    }
    cols = ', '.join(cols_vals.keys())
    vals = ', '.join(sql_quote(v) for v in cols_vals.values())
    sql_lines.append(f"INSERT INTO player_contracts ({cols}) VALUES ({vals});")

sql_lines.append("")

# Generate 2012 inserts
sql_lines.append(f"-- Step 4: Insert {len(derived_rows)} 2012 termination rows (source='event_chain_2012_v1')")
sorted_2012 = sorted(derived_rows, key=lambda r: r['origin_date_iso'])
for r in sorted_2012:
    pid = r['player_id']
    seq = next_seq(pid)
    # Note: we won't include _-prefixed tracking fields
    cols_vals = {
        'player_id': pid,
        'contract_seq': seq,
        'origin_event': r['origin_event'],
        'origin_date_iso': r['origin_date_iso'],
        'origin_franchise_id': r['origin_franchise_id'],
        'contract_type': r['contract_type'],
        'contract_length_cl': r['contract_length_cl'],
        'aav_usd': r['aav_usd'],
        'tcv_usd': r['tcv_usd'],
        'year_salaries_json': r['year_salaries_json'],
        'origin_aav_usd': r['origin_aav_usd'],
        'origin_tcv_usd': r['origin_tcv_usd'],
        'origin_cl': r['origin_cl'],
        'termination_event': r['termination_event'],
        'termination_date_iso': r['termination_date_iso'],
        'termination_franchise_id': r['termination_franchise_id'],
        'cap_hit_usd': r['cap_hit_usd'],
        'earned_at_termination_usd': r['earned_at_termination_usd'],
        'source': 'event_chain_2012_v1',
        'notes': r['notes'],
    }
    cols = ', '.join(cols_vals.keys())
    vals = ', '.join(sql_quote(v) for v in cols_vals.values())
    sql_lines.append(f"INSERT INTO player_contracts ({cols}) VALUES ({vals});")

sql_lines.append("")
sql_lines.append("-- Step 5: Origin stints will be inserted via a follow-up script after we have contract_ids")
sql_lines.append("-- (D1 auto-increments contract_id on insert; we read them back and insert stints).")

with open(WORK / 'backfill_2011_2012.sql', 'w') as f:
    f.write('\n'.join(sql_lines))
print(f'\nGenerated SQL: {WORK / "backfill_2011_2012.sql"} ({len(sql_lines)} lines)')

# Write rows for later stint insertion
with open(WORK / 'rows_for_stints.json', 'w') as f:
    json.dump({
        'rows_2012': [{k:v for k,v in r.items() if not k.startswith('_')} for r in derived_rows],
        'rows_2011': derived_2011,
    }, f, indent=2)
print(f'Wrote: {WORK / "rows_for_stints.json"}')
