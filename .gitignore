# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Runtime data (never commit)
pipelines/etl/data/
pipelines/etl/inputs/*.xlsx
pipelines/etl/inputs/*.csv
pipelines/etl/artifacts/
services/rulebook/data/feedback.db
services/rulebook/data/rule_feedback.db
services/**/*.db-journal
services/**/*.db-wal
services/**/*.db-shm

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
scripts/scheduler/logs/
*.log

# Node / Cloudflare
node_modules/
.wrangler/

# Local-only Claude tooling
.claude/

# Local-only review aids — created on the fly during hub reviews,
# always present orange 'LOCAL REVIEW' banners + point at prod worker.
# Useful in worktree, never meant for main.
_local_*.html

# pipelines/reports/ — pipeline build outputs (regeneratable). The
# pipelines/etl/data/ + /artifacts/ + /inputs/ patterns above already
# guard most pipeline output, but contract_history_*.csv files escaped
# into pipelines/reports/ in earlier work. Pruned 2026-05-13 to keep
# the repo under jsDelivr's 50MB package limit. Re-running the build
# scripts regenerates them locally.
pipelines/reports/*.csv

.dev.vars*
!.dev.vars.example
!.env.example

# ── Fantasy multi-platform ingestion (Yahoo) ────────────────────────────────
# Raw provider payloads. Gzipped API responses; a full historical backfill is
# ~180MB, which does NOT belong in a repo already pruned to stay under
# jsDelivr's 50MB package limit. Keep locally, or send to R2 with --raw-sink=r2.
data/yahoo-raw/
data/fantasy-raw/

# The real counterpart of pipelines/etl/config/runtime.env.example. The root
# `.env` pattern above matches ONLY a file literally named `.env`, so this
# needed its own entry — a credentials file here would otherwise be committable.
pipelines/etl/config/runtime.env
pipelines/fantasy/config/*.env

# Root node_modules — the root package.json ships zero dependencies, but npm
# creates this directory anyway on some commands.
/node_modules/
